#!/bin/bash
#SBATCH --account=iscrc_aim
#SBATCH --partition=boost_usr_prod
#SBATCH --gres=gpu:1
#SBATCH --time=03:00:00
#SBATCH --cpus-per-task=8
#SBATCH --job-name=continual-bench
#SBATCH -o results/%x-%j.out
#SBATCH --chdir=/leonardo_work/IscrC_AIM/open-set-tta-dlai

set -euo pipefail

cd /leonardo_work/IscrC_AIM/open-set-tta-dlai

mkdir -p results

# Continual/online benchmark (paper protocol). All methods → multirun/continual_bench/<method>/.
# seed=0 reuses the SVHN-C caches generated by the Phase-3 sweep (fast).
#
# Baselines use ONLY their declared design: faithful = NO warm-up (paper uses constant LR),
# so override method.warmup_K=0 for them. NOVA keeps its full contributions (warmup_K=10 from
# its config). --no-sync REQUIRED on compute nodes.

# All methods with FAITHFUL configs (Tent: +marginal/no-warmup; UniEnt/+:
# +reliability_gate, no-warmup; NOVA: its full design). One multirun →
# multirun/continual_faithful/<method>/. seed=0 reuses the sweep's SVHN-C caches.
env -u VIRTUAL_ENV uv run --no-sync python src/run_continual.py -m \
  method=bnadapt,tent,unient,unient_plus,nova device=cuda seed=0 \
  hydra.sweep.dir=multirun/continual_faithful
